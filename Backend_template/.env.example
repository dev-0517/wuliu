# 本地开发默认 SQLite，无需安装数据库
# DATABASE_URL=sqlite:///./logistics.db
# 生产（compose 内注入）：
DATABASE_URL=mysql+pymysql://logistics:logistics_pwd@mysql:3306/logistics?charset=utf8mb4

# JWT 签名密钥，生产务必改成随机长字符串
SECRET_KEY=please-change-this-secret
TOKEN_EXPIRE_HOURS=24

# 同源部署可保持 *；如需限制写成逗号分隔
CORS_ORIGINS=*

# 短信验证码通道（二选一，Spug 优先）
# Spug 推送：控制台-短信验证码-代码调试 里复制完整调用 URL
SPUG_SMS_URL=
# 阿里云短信
SMS_ACCESS_KEY_ID=
SMS_ACCESS_KEY_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
